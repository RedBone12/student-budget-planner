{
  "name": "student-budget-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:regression && vitest run",
    "lint": "cd .. && node frontend/node_modules/eslint/bin/eslint.js frontend/src frontend/tests frontend/e2e frontend/*.js eslint.config.mjs backend/src backend/tests --max-warnings=0",
    "coverage": "npm run coverage:logic && vitest run --coverage",
    "test:regression": "node --test tests/*.test.js",
    "test:components": "vitest run tests/components",
    "test:e2e": "playwright test",
    "coverage:logic": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=74 --test-coverage-branches=82 --test-coverage-functions=77 tests/*.test.js",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "aws-amplify": "^6.20.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
